<?xml version="1.0" encoding="utf-8"?>
<!--
    Fit10 Full Backup Rules (Android 11 and below / API <= 30)
    
    Privacy Policy & Architecture Decision:
    Fit10 is an offline-first fitness application where all exercise logs, fatigue
    ratings, and personalization metrics are strictly confidential and intended to remain
    on-device. To prevent automatic upload of private health metrics to Google Drive
    Auto-Backup:
    - The Room SQLite database (fit10.db) is strictly excluded.
    - DataStore preference directories (datastore/) are strictly excluded.
    - Local preference files (fit10_preferences, billing cache, keystore prefs) are excluded.
    
    Open Question for Product/Engineering:
    Whether to allow opt-in encrypted backup export files to Google Drive in a future version.
-->
<full-backup-content>
    <exclude domain="database" path="fit10.db" />
    <exclude domain="database" path="fit10.db-shm" />
    <exclude domain="database" path="fit10.db-wal" />
    <exclude domain="database" path="." />
    <exclude domain="file" path="datastore" />
    <exclude domain="sharedpref" path="fit10_preferences.preferences_pb" />
    <exclude domain="sharedpref" path="fit10_billing_cache.xml" />
    <exclude domain="sharedpref" path="fit10_keystore_prefs.xml" />
    <exclude domain="sharedpref" path="fit10_analytics_prefs.xml" />
</full-backup-content>